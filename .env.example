# Salin file ini menjadi .env.local lalu isi dengan nilai dari project Supabase kamu.
# Project Settings -> API di dashboard Supabase.
#
# URL: alamat dasar project saja, TANPA /rest/v1 di belakangnya.
# KEY: kunci anon/publishable. Jangan pernah memakai kunci service_role di aplikasi.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key